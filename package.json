{
  "name": "openwa",
  "version": "0.1.6",
  "description": "Open Source WhatsApp API Gateway - Free, Self-Hosted HTTP API for WhatsApp",
  "author": "Yudhi Armyndharis & OpenWA Contributors",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "dev": "concurrently -n api,dashboard -c blue,green \"npm run start:dev\" \"npm run dashboard:dev\"",
    "dashboard:install": "cd dashboard-ui && npm install",
    "dashboard:dev": "cd dashboard-ui && npm run dev",
    "dashboard:build": "cd dashboard-ui && npm run build",
    "postinstall": "node -e \"if (require('fs').existsSync('dashboard-ui')) require('child_process').spawnSync('npm', ['run', 'dashboard:install'], { stdio: 'inherit', shell: true });\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "typeorm:prod": "typeorm",
    "migration:create": "npm run typeorm -- migration:create database/migrations/$npm_config_name",
    "migration:generate": "npm run typeorm -- migration:generate database/migrations/$npm_config_name -d database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d database/data-source.ts",
    "migration:run:prod": "npm run typeorm:prod -- migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run typeorm -- migration:revert -d database/data-source.ts",
    "migration:revert:prod": "npm run typeorm:prod -- migration:revert -d dist/database/data-source.js",
    "migration:show": "npm run typeorm -- migration:show -d database/data-source.ts",
    "migration:show:prod": "npm run typeorm:prod -- migration:show -d dist/database/data-source.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@hapi/boom": "^10.0.1",
    "@bull-board/api": "^7.2.1",
    "@bull-board/express": "^7.2.1",
    "@bull-board/nestjs": "^7.2.1",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.25",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.25",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.25",
    "@nestjs/platform-socket.io": "^11.1.25",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "archiver": "^8.0.0",
    "axios": "^1.18.1",
    "baileys": "6.7.24",
    "bullmq": "^5.78.0",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dockerode": "^5.0.0",
    "form-data": "^4.0.6",
    "formdata-node": "^6.0.3",
    "fs-extra": "^10.1.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.7",
    "tar-stream": "^3.2.0",
    "typeorm": "^0.3.29",
    "unzipper": "^0.12.3",
    "uuid": "^14.0.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.22",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.25",
    "@types/archiver": "^7.0.0",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/tar-stream": "^3.1.4",
    "@types/uuid": "^11.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "@database/(.*)$": "<rootDir>/../database/$1",
      "@whatsapp-engine/(.*)$": "<rootDir>/../whatsapp-engine/$1",
      "@scraper/(.*)$": "<rootDir>/../scraper/$1",
      "@core/(.*)$": "<rootDir>/core/$1",
      "@common/(.*)$": "<rootDir>/common/$1",
      "^baileys$": "<rootDir>/../test/__mocks__/baileys.js"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 10,
        "functions": 12,
        "lines": 15,
        "statements": 15
      }
    },
    "testEnvironment": "node"
  },
  "overrides": {
    "tar": "^7.5.19",
    "@tootallnate/once": "^2.0.1"
  }
}
